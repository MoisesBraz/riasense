# Copiar para .env e ajustar. Nunca versionar o .env.

# Pasta com os CSV do Living Lab (cópia partilhada no Nextcloud da equipa).
# Exemplo no macOS:
RIASENSE_DATA_RAW="/Users/<utilizador>/Library/CloudStorage/Nextcloud-<conta>/Hackathon Aveiro/2026/Projeto_desafio_1/03-dados/brutos"
# Tabelas limpas (Parquet) escritas por `riasense ingerir`: grandes e regeneráveis, fora do git.
RIASENSE_DATA_INTERIM=./data/interim
# Resultados finais das camadas (Parquet pequenos), versionados no repositório.
RIASENSE_DATA_PROCESSED=./data/processed

# API (FastAPI)
API_PORT=8000

# Web (Vite). O mapa offline é um ficheiro PMTiles servido pela própria web (ADR-0014): não há porta de tiles.
WEB_PORT=5173
# Só para o `npm run dev` da web. No `docker compose`, a web chama a API em /api, na mesma origem.
VITE_API_URL=http://localhost:8000
